<Window x:Class="MSGuide.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MSGuide · Desktop companion" Width="480" Height="780" MinWidth="390" MinHeight="380" WindowStartupLocation="CenterScreen">
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <DockPanel><TextBlock Text="MSGuide" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="GUIDE + SCOPED CONTROL" Foreground="#82DCFF" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
      <TextBlock Text="Your next step, in context." Foreground="#A8BAD1" Margin="0,2,0,10"/>
      <Border Background="#182C40" CornerRadius="7" Padding="10"><TextBlock x:Name="StatusText" Text="Not connected · no capture or recording active" AutomationProperties.LiveSetting="Polite"/></Border>
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,8" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <TextBlock Text="Local MVP: demo mode is deterministic, not AI. Model mode uses the backend's configured provider, which may process approved data remotely. No enterprise identity or document permissions are established here. Use synthetic/public content only." Foreground="#A8BAD1" FontSize="12"/>
        <WrapPanel Margin="0,7,0,10"><Button Content="Open demo" Click="OpenDemo_Click"/><Button Content="Check service" Click="Health_Click"/></WrapPanel>
        <Border Background="#182C40" CornerRadius="8" Padding="12" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock Text="Try one task in two modes" FontSize="17" FontWeight="SemiBold"/>
            <TextBlock Text="Two bounded tasks: investigate the sample build, or insert a draft into blank Notepad. Local adapters, not AI or arbitrary screen control." FontSize="12" Foreground="#A8BAD1" Margin="0,5,0,8"/>
            <WrapPanel>
              <RadioButton x:Name="GuideMode" Content="Guide me" GroupName="Interaction" IsChecked="True" Checked="Interaction_Changed" Foreground="White" Margin="0,0,16,8"/>
              <RadioButton x:Name="ControlMode" Content="Do it for me" GroupName="Interaction" Checked="Interaction_Changed" Foreground="White"/>
            </WrapPanel>
            <Button Content="Prepare demo task" Click="PrepareTask_Click"/>
            <Expander Header="Notepad · approved draft" Foreground="#EDF3FF" Margin="0,8,0,8">
              <StackPanel>
                <TextBlock Text="Experimental: use a separate Notepad window with exactly one blank tab, then refresh and select it below. Control requires MSGUIDE_ENABLE_EXPERIMENTAL_NOTEPAD_CONTROL=1 for synthetic testing pending native acceptance. No Save command is issued, but Notepad may retain unsaved tabs. Keep MSGuide foreground during insertion." FontSize="12" Margin="0,6,0,6"/>
                <TextBox x:Name="DraftBox" Text="MSGuide demo: this draft was prepared with permission." MaxLength="1000" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="140" VerticalScrollBarVisibility="Auto" IsUndoEnabled="False" TextChanged="Draft_Changed" AutomationProperties.Name="Exact approved Notepad draft"/>
                <Button Content="Prepare selected Notepad task" Click="PrepareNotepad_Click"/>
              </StackPanel>
            </Expander>
            <TextBlock x:Name="TaskPlanText" Text="Open demo, choose a mode and prepare the task. The question below is for the separate snapshot-guidance workflow." FontSize="12" Margin="0,6,0,8"/>
            <CheckBox x:Name="TaskConsent" Checked="TaskConsent_Changed" Unchecked="TaskConsent_Changed"><TextBlock Text="I approve this exact plan, target and local state/text checks; in Do it for me mode, I also approve its listed actions. Only synthetic content is in scope."/></CheckBox>
            <WrapPanel>
              <Button x:Name="StartTaskButton" Content="Start approved task" Click="StartTask_Click" IsEnabled="False"/>
              <Button x:Name="ObserveTaskButton" Content="I did it · check" Click="ObserveTask_Click" IsEnabled="False"/>
            </WrapPanel>
            <TextBlock x:Name="TaskStatusText" Text="No task active." AutomationProperties.LiveSetting="Polite" Foreground="#82DCFF"/>
          </StackPanel>
        </Border>
        <TextBlock Text="1  Ask a question" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <TextBox x:Name="PromptBox" Text="Help me find the build error" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxHeight="160" MaxLength="4000" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Question or editable speech transcript" TextChanged="Prompt_Changed" IsUndoEnabled="False"/>
        <WrapPanel><Button x:Name="MicButton" Content="Start microphone" Click="Mic_Click"/><Button Content="Stop speech" Click="StopSpeech_Click"/></WrapPanel>
        <TextBlock x:Name="SpeechText" Text="Microphone off · click start/stop, never always listening." FontSize="12" Foreground="#A8BAD1" AutomationProperties.LiveSetting="Polite"/>
        <TextBlock Text="2  Choose exactly one window" FontWeight="SemiBold" Margin="0,18,0,6"/>
        <ComboBox x:Name="WindowPicker" MinHeight="34" Foreground="#101827" AutomationProperties.Name="Window to capture" SelectionChanged="Window_Changed"/>
        <WrapPanel><Button Content="Refresh windows" Click="Refresh_Click"/><Button x:Name="CaptureButton" Content="Capture / review" Click="Capture_Click"/></WrapPanel>
        <TextBlock Text="Capture is manual and local. UI Automation excludes password controls, but screenshot pixels are NOT redacted. Inspect both image and text for passwords, secrets, or personal information before approving." FontSize="12" Foreground="#E8C98B"/>
        <Border x:Name="ReviewPanel" Visibility="Collapsed" BorderBrush="#44657D" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,14,0,0">
          <StackPanel>
            <TextBlock Text="3  Review this snapshot · expires in 60 seconds" FontWeight="SemiBold"/>
            <TextBlock x:Name="CaptureDetails" FontSize="12" Margin="0,6,0,8" Foreground="#A8BAD1"/>
            <Border Background="#05080D" BorderBrush="#46627E" BorderThickness="1"><Image x:Name="PreviewImage" MaxHeight="250" Stretch="Uniform" AutomationProperties.Name="Actual selected-window capture preview"/></Border>
            <Expander Header="Inspect image at full size" Foreground="#EDF3FF" Margin="0,6,0,6"><ScrollViewer Height="280" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><Image x:Name="FullPreviewImage" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" AutomationProperties.Name="Full resolution captured image"/></ScrollViewer></Expander>
            <TextBlock Text="UI Automation text (not OCR) and normalized element boxes — sent on approval:" FontSize="12" Margin="0,6,0,4"/>
            <TextBox x:Name="MetadataText" IsReadOnly="True" IsUndoEnabled="False" TextWrapping="Wrap" Height="130" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Exact accessible text and element metadata to share"/>
            <CheckBox x:Name="ShareImage" Checked="Approval_Changed" Unchecked="Approval_Changed"><TextBlock Text="Also send screenshot pixels (off by default). A vision provider may need them."/></CheckBox>
            <CheckBox x:Name="ConsentBox" Checked="Approval_Changed" Unchecked="Approval_Changed"><TextBlock Text="I reviewed this snapshot and approve sending its text/boxes and, only if checked, image to the configured service/provider."/></CheckBox>
            <WrapPanel><Button x:Name="SendButton" Content="Send approved snapshot" Background="#20658F" Click="Send_Click" IsEnabled="False"/><Button Content="Discard" Click="Discard_Click"/></WrapPanel>
          </StackPanel>
        </Border>
        <Border Background="#182334" CornerRadius="8" Padding="14" Margin="0,16,0,0">
          <StackPanel>
            <TextBlock x:Name="ModeText" Text="GUIDANCE · no response yet" FontSize="11" Foreground="#82DCFF" Margin="0,0,0,8"/>
            <TextBlock x:Name="AnswerText" Text="Open the synthetic demo, choose MSGuide Demo, then capture and review. You stay in control of every click." FontSize="16" AutomationProperties.LiveSetting="Polite"/>
            <StackPanel x:Name="CitationsPanel" Margin="0,8,0,0"/>
            <WrapPanel><Button x:Name="NextButton" Content="Check next step" Click="Capture_Click"/><Button x:Name="SpeakButton" Content="Speak response" Click="Speak_Click" IsEnabled="False"/></WrapPanel>
            <TextBlock Text="Check next step takes a NEW capture for review. It never uploads automatically." FontSize="12" Foreground="#A8BAD1"/>
          </StackPanel>
        </Border>
        <TextBlock x:Name="HotkeyText" Text="Ctrl+Alt+M · show near cursor" Foreground="#A8BAD1" FontSize="12" Margin="0,12,0,0"/>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2">
      <WrapPanel><Button Content="Stop task" Click="StopTask_Click" Background="#803C46"/><Button Content="Take over manually" Click="TakeOver_Click"/></WrapPanel>
      <WrapPanel><Button Content="Pause / clear" Click="Pause_Click"/><Button Content="Dismiss" Click="Dismiss_Click"/><Button Content="Exit" Click="Exit_Click"/></WrapPanel>
    </StackPanel>
  </Grid>
</Window>