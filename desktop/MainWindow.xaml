<Window x:Class="MSGuide.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MSGuide · Desktop companion"
        Width="680" Height="820" MinWidth="460" MinHeight="440"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBrush}"
        Opacity="1"
        AllowsTransparency="False"
        KeyboardNavigation.TabNavigation="Continue">
  <Grid Background="{StaticResource CanvasBrush}" Margin="24,20,24,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="MSGuide" FontSize="24" FontWeight="SemiBold"/>
          <TextBlock x:Name="ProductSubtitle"
                     Text="Your guide to getting things done at Microsoft."
                     TextWrapping="Wrap"
                     Style="{StaticResource CaptionStyle}" Margin="0,2,0,0"/>
        </StackPanel>
        <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
          <Border x:Name="CameraModePill"
                  Style="{StaticResource PillStyle}"
                  Background="{StaticResource AccentSoftBrush}">
            <TextBlock x:Name="CameraModePillText"
                       Text="GUIDE ME"
                       Foreground="{StaticResource AccentBrush}"
                       FontSize="11"
                       FontWeight="SemiBold"/>
          </Border>
          <Border x:Name="ScreenSharePill"
                  Style="{StaticResource PillStyle}"
                  AutomationProperties.Name="Screen sharing status">
            <TextBlock x:Name="ScreenShareText"
                       Text="NOT SHARED"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="11"
                       FontWeight="SemiBold"/>
          </Border>
        </WrapPanel>
      </Grid>
      <Border Style="{StaticResource PillStyle}" Margin="0,12,0,0" Padding="11,7">
        <TextBlock x:Name="StatusText"
                   Text="Connecting · no capture or recording active"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource MutedTextBrush}"
                   AutomationProperties.LiveSetting="Polite"
                   AutomationProperties.Name="Application status"/>
      </Border>
    </StackPanel>

    <ScrollViewer x:Name="WorkspaceScroll"
                  Grid.Row="1" Grid.RowSpan="2"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Margin="0,12,0,10"
                  Padding="0,0,8,0"
                  AutomationProperties.Name="MSGuide workspace">
      <StackPanel>
    <Border Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,0,14">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="Ask MSGuide" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <Border Grid.Column="1" Style="{StaticResource PillStyle}" Margin="0,0,0,6">
            <TextBlock x:Name="MicrophoneStateText" Text="MIC OFF" FontSize="10" Foreground="{StaticResource MutedTextBrush}"/>
          </Border>
        </Grid>
        <Grid x:Name="InteractionModePanel" Margin="0,4,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="Mode" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
          <StackPanel Grid.Column="1">
            <WrapPanel>
              <RadioButton x:Name="CameraGuideMode"
                           Content="Guide me"
                           GroupName="CameraInteraction"
                           IsChecked="True"
                           ToolTipService.ShowOnDisabled="True"
                           Checked="CameraMode_Changed"/>
              <RadioButton x:Name="CameraControlMode"
                           Content="Fix it for me"
                           GroupName="CameraInteraction"
                           ToolTipService.ShowOnDisabled="True"
                           Checked="CameraMode_Changed"/>
              <Button x:Name="CameraSwitchModeButton"
                      Content="Stop and switch mode"
                      Click="CameraSwitchMode_Click"
                      Style="{StaticResource QuietButtonStyle}"
                      Margin="10,0,0,0"
                      Visibility="Collapsed"
                      AutomationProperties.Name="Stop recovery and switch interaction mode"/>
            </WrapPanel>
            <TextBlock x:Name="CameraModeHint"
                       Text="You make changes; MSGuide guides you and checks results."
                       Style="{StaticResource CaptionStyle}"
                       TextWrapping="Wrap"
                       Margin="0,2,0,0"
                       AutomationProperties.LiveSetting="Polite"/>
          </StackPanel>
        </Grid>
        <TextBlock Text="What do you need help with?"
                   Style="{StaticResource CaptionStyle}" Margin="0,0,0,5"/>
        <TextBox x:Name="PromptBox"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 MinHeight="54"
                 MaxHeight="96"
                 MaxLength="4000"
                 VerticalScrollBarVisibility="Auto"
                 AutomationProperties.Name="Shared editable question and speech transcript"
                 AutomationProperties.HelpText="Enter asks MSGuide. Shift+Enter adds a new line."
                 PreviewKeyDown="PromptBox_PreviewKeyDown"
                 TextChanged="Prompt_Changed"
                 IsUndoEnabled="False"/>
        <WrapPanel Margin="0,8,0,0">
          <Button x:Name="AskPromptButton"
                  Content="Ask MSGuide"
                  Click="AskPrompt_Click"
                  Style="{StaticResource PrimaryButtonStyle}"
                  AutomationProperties.Name="Ask MSGuide"
                  AutomationProperties.HelpText="Submit your question. No camera or permission change is authorized by asking."/>
          <Button x:Name="UseScreenContextButton"
                  Content="Use screen context"
                  Click="UseScreenContext_Click"
                  Style="{StaticResource QuietButtonStyle}"
                  Visibility="Collapsed"
                  AutomationProperties.Name="Choose a window and review its context before sharing"/>
          <TextBlock Text="Enter to ask · Shift+Enter for a new line"
                     Style="{StaticResource CaptionStyle}"
                     TextWrapping="Wrap"
                     VerticalAlignment="Center"
                     Margin="4,0,0,0"/>
        </WrapPanel>
        <TextBlock x:Name="PromptFeedbackText"
                   Style="{StaticResource CaptionStyle}"
                   TextWrapping="Wrap"
                   Margin="0,4,0,0"
                   Visibility="Collapsed"
                   AutomationProperties.LiveSetting="Polite"
                   AutomationProperties.Name="Question status"/>
        <Grid Margin="0,5,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <WrapPanel>
            <Button x:Name="MicButton"
                    Content="Start microphone"
                    Click="Mic_Click"
                    Style="{StaticResource QuietButtonStyle}"
                    AutomationProperties.Name="Record a new voice question"/>
            <Button x:Name="AddVoiceButton"
                    Content="Add more"
                    Click="AddVoice_Click"
                    Style="{StaticResource QuietButtonStyle}"
                    Visibility="Collapsed"
                    AutomationProperties.Name="Add more dictation to the current question"/>
          </WrapPanel>
          <TextBlock x:Name="SpeechText"
                     Grid.Column="1"
                     Text="Microphone off · never always listening"
                     Style="{StaticResource CaptionStyle}"
                     TextWrapping="Wrap"
                     VerticalAlignment="Center"
                     AutomationProperties.LiveSetting="Polite"
                     AutomationProperties.Name="Speech status"/>
          <Button Grid.Column="2"
                  x:Name="StopAudioButton"
                  Content="Stop audio"
                  Click="StopSpeech_Click"
                  Style="{StaticResource QuietButtonStyle}"
                  AutomationProperties.Name="Stop dictation and playback"/>
        </Grid>
        <TextBlock x:Name="SpeechPreviewText"
                  Style="{StaticResource CaptionStyle}"
                  TextWrapping="Wrap"
                  Margin="0,6,0,0"
                  Visibility="Collapsed"
                  AutomationProperties.Name="Provisional local transcript"
                  AutomationProperties.LiveSetting="Polite"/>
        <Grid x:Name="SpeechInputPanel" Margin="0,6,0,0" Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="Input level" Style="{StaticResource CaptionStyle}" Margin="0,0,10,0"/>
          <ProgressBar x:Name="SpeechInputLevel"
                      Grid.Column="1"
                      Maximum="100"
                      Height="6"
                      VerticalAlignment="Center"
                      AutomationProperties.Name="Microphone input level"/>
        </Grid>
        <WrapPanel Margin="0,4,0,0">
          <Button Content="Voice settings"
                  Click="VoiceSettings_Click"
                  Style="{StaticResource QuietButtonStyle}"
                  AutomationProperties.Name="Open voice settings and microphone selection"/>
          <TextBlock Text="Voice stays on this device · review before asking"
                    Style="{StaticResource CaptionStyle}"
                    TextWrapping="Wrap"
                    VerticalAlignment="Center"/>
        </WrapPanel>
      </StackPanel>
    </Border>

        <Border x:Name="CameraRecoveryCard"
                Style="{StaticResource CardStyle}"
                BorderBrush="#3D7392"
                Visibility="Collapsed"
                AutomationProperties.Name="Current task: Teams camera">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Teams camera" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock x:Name="CameraModeSubtitle"
                           Text="You make every click. MSGuide verifies each next step."
                           Style="{StaticResource CaptionStyle}" Margin="0,3,12,0"/>
              </StackPanel>
              <Border Grid.Column="1" Style="{StaticResource PillStyle}" Background="{StaticResource AccentSoftBrush}">
                <TextBlock x:Name="CameraSensingText"
                           Text="Local sensing"
                           FontSize="11"
                           Foreground="{StaticResource AccentBrush}"
                           AutomationProperties.Name="Camera sensing mode"/>
              </Border>
            </Grid>

            <WrapPanel Margin="0,12,0,8">
              <Border Style="{StaticResource PillStyle}">
                <TextBlock Text="Controls-only inspection" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
              </Border>
              <Border Style="{StaticResource PillStyle}">
                <TextBlock Text="Local visual check" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
              </Border>
              <Border Style="{StaticResource PillStyle}">
                <TextBlock x:Name="CameraActionPolicyText"
                           Text="No automatic clicks"
                           FontSize="11"
                           Foreground="{StaticResource MutedTextBrush}"/>
              </Border>
            </WrapPanel>

            <Grid x:Name="CameraProgressPanel" Margin="0,2,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <ProgressBar x:Name="CameraProgressBar"
                           Maximum="7"
                           Value="0"
                           VerticalAlignment="Center"
                           AutomationProperties.Name="Camera recovery progress"/>
              <TextBlock x:Name="CameraProgressText"
                         Grid.Column="1"
                         Text="Ready when you are"
                         Style="{StaticResource CaptionStyle}"
                         Margin="12,0,0,0"
                         VerticalAlignment="Center"/>
            </Grid>

            <TextBlock x:Name="CameraIdleHint"
                       Text="Choose a mode, then ask your question above or start camera recovery below."
                       Style="{StaticResource CaptionStyle}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0"/>
            <Border x:Name="CameraStatePanel"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="CameraStateGlyph"
                           Text="1"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}"
                           Margin="0,1,12,0"
                           AutomationProperties.Name="Current recovery state indicator"/>
                <StackPanel Grid.Column="1">
                  <TextBlock x:Name="CameraStateText"
                             Text="Ready to help"
                             FontWeight="SemiBold"
                             AutomationProperties.LiveSetting="Assertive"
                             AutomationProperties.Name="Camera recovery state"/>
                  <TextBlock x:Name="CameraStepText"
                             Text="Start when you want guide-only help with a Teams camera."
                             Style="{StaticResource CaptionStyle}"
                             TextWrapping="Wrap"
                             Margin="0,3,0,0"
                             AutomationProperties.LiveSetting="Polite"
                             AutomationProperties.Name="Camera recovery next step"/>
                </StackPanel>
              </Grid>
            </Border>

            <StackPanel x:Name="CameraSelectionPanel" Visibility="Collapsed" Margin="0,12,0,0">
              <TextBlock Text="Teams window" FontWeight="SemiBold" Margin="0,0,0,6"/>
              <ComboBox x:Name="CameraWindowPicker"
                        AutomationProperties.Name="Exact Teams window for camera recovery"
                        IsTextSearchEnabled="False"
                        SelectionChanged="CameraWindow_Changed"/>
              <TextBlock x:Name="CameraWindowHint"
                         Text="Open Teams, then choose its Settings > Devices window."
                         Style="{StaticResource CaptionStyle}"
                         Margin="0,6,0,0"
                         AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>

            <WrapPanel x:Name="CameraPrimaryActions" Margin="0,10,0,0">
              <Button x:Name="CameraStartButton"
                      Content="Start camera recovery"
                      Click="CameraStart_Click"
                      Style="{StaticResource PrimaryButtonStyle}"
                      AutomationProperties.Name="Start Teams camera recovery"/>
              <Button x:Name="CameraChooseWindowButton"
                      Content="Choose Teams window"
                      Click="CameraChooseWindow_Click"
                      Style="{StaticResource PrimaryButtonStyle}"
                      Visibility="Collapsed"
                      AutomationProperties.Name="Refresh and choose the exact Teams window"/>
              <Button x:Name="CameraInspectButton"
                      Content="Inspect controls only"
                      Click="CameraInspect_Click"
                      Style="{StaticResource PrimaryButtonStyle}"
                      IsEnabled="False"
                      Visibility="Collapsed"
                      AutomationProperties.Name="Inspect current controls without a screenshot"/>
              <Button x:Name="CameraOpenSettingsButton"
                      Content="Open Camera settings"
                      Click="CameraOpenSettings_Click"
                      Style="{StaticResource PrimaryButtonStyle}"
                      IsEnabled="False"
                      Visibility="Collapsed"
                      AutomationProperties.Name="Open Windows camera privacy settings"/>
              <Button x:Name="CameraPrivateCheckButton"
                      Content="Private visual check"
                      Click="CameraPrivateCheck_Click"
                      Style="{StaticResource PrimaryButtonStyle}"
                      IsEnabled="False"
                      Visibility="Collapsed"
                      AutomationProperties.Name="Run a private Settings or Teams visual check"/>
              <Button x:Name="CameraShowButton"
                      Content="Show me"
                      Click="CameraShow_Click"
                      Style="{StaticResource PrimaryButtonStyle}"
                      IsEnabled="False"
                      Visibility="Collapsed"
                      AutomationProperties.Name="Show the current verified camera permission target"/>
              <Button x:Name="CameraChangedCheckButton"
                      Content="I changed it · check again"
                      Click="CameraChangedCheck_Click"
                      Style="{StaticResource PrimaryButtonStyle}"
                      IsEnabled="False"
                      Visibility="Collapsed"
                      AutomationProperties.Name="Check Camera Settings after my change"/>
              <Button x:Name="CameraControlTargetButton"
                      Content="Approve camera fix"
                      Click="CameraControlTarget_Click"
                      Style="{StaticResource PrimaryButtonStyle}"
                      IsEnabled="False"
                      Visibility="Collapsed"
                      AutomationProperties.Name="Approve one exact verified camera action"/>
              <Button x:Name="CameraReturnButton"
                      Content="Return to Teams"
                      Click="CameraReturn_Click"
                      Style="{StaticResource PrimaryButtonStyle}"
                      IsEnabled="False"
                      Visibility="Collapsed"
                      AutomationProperties.Name="Return focus to the selected Teams window"/>
              <Button x:Name="CameraRestartTeamsButton"
                      Content="Approve Teams restart"
                      Click="CameraRestartTeams_Click"
                      Style="{StaticResource QuietButtonStyle}"
                      IsEnabled="False"
                      Visibility="Collapsed"
                      AutomationProperties.Name="Approve closing and relaunching Microsoft Teams"/>
            </WrapPanel>

            <WrapPanel x:Name="CameraSessionActions" Margin="0,2,0,0" Visibility="Collapsed">
              <Button x:Name="CameraStopButton"
                      Content="Stop recovery"
                      Click="CameraStop_Click"
                      Style="{StaticResource DangerButtonStyle}"
                      IsEnabled="False"
                      AutomationProperties.Name="Stop camera recovery"/>
              <Button x:Name="CameraTakeOverButton"
                      Content="Stop and take over"
                      Click="CameraTakeOver_Click"
                      Style="{StaticResource QuietButtonStyle}"
                      IsEnabled="False"
                      AutomationProperties.Name="Stop guidance and take over manually"/>
            </WrapPanel>
          </StackPanel>
        </Border>

        <Expander x:Name="SettingsExpander" Header="Settings"
                  Margin="0,12,0,0"
                  IsExpanded="False"
                  AutomationProperties.Name="Settings">
          <StackPanel Margin="0,10,0,0">
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Text="Voice" Style="{StaticResource SectionTitleStyle}"/>
                <TextBlock Text="Local Whisper · English · stop recording to transcribe"
                           Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                <TextBlock Text="Microphone" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <ComboBox x:Name="MicrophonePicker"
                          SelectionChanged="MicrophonePicker_SelectionChanged"
                          AutomationProperties.Name="Microphone for local dictation"/>
                <WrapPanel Margin="0,6,0,0">
                  <Button x:Name="RefreshMicrophonesButton"
                          Content="Refresh inputs"
                          Click="RefreshMicrophones_Click"
                          Style="{StaticResource QuietButtonStyle}"
                          AutomationProperties.Name="Refresh microphone inputs"/>
                  <Button Content="Sound input settings"
                          Click="MicrophoneSettings_Click"
                          Style="{StaticResource QuietButtonStyle}"
                          AutomationProperties.Name="Open Windows Sound settings to choose the microphone"/>
                  <Button Content="Back to question"
                          Click="BackToQuestion_Click"
                          Style="{StaticResource QuietButtonStyle}"/>
                </WrapPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Text="Connection" Style="{StaticResource SectionTitleStyle}"/>
                <TextBlock x:Name="ConnectionStatusText" Text="Checking the local connection..."
                           Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" Margin="0,4,0,8"
                           AutomationProperties.Name="Connection status" AutomationProperties.LiveSetting="Polite"/>
                <Button x:Name="CheckServiceButton" Content="Check connection" Click="Health_Click"
                        HorizontalAlignment="Left" AutomationProperties.Name="Check the local service connection"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="Privacy and control" Style="{StaticResource SectionTitleStyle}"/>
                <TextBlock Text="Voice transcription and camera checks run locally. Some camera preview checks inspect the selected window locally; they do not upload it. Sharing screen context for additional guidance requires a separate review and approval."
                           Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" Margin="0,5,0,8"/>
                <TextBlock Text="MSGuide asks before changing a camera or permission setting. A broader permission change or Teams restart requires its own approval. A permission being on is not proof that the camera is working."
                           Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/>
                <WrapPanel Margin="0,8,0,0">
                  <Button Content="Pause and clear" Click="Pause_Click"/>
                  <Button Content="Exit MSGuide" Click="Exit_Click" Style="{StaticResource DangerButtonStyle}"/>
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </Expander>

        <Expander x:Name="DeveloperToolsExpander" Header="Developer tools"
                  Margin="0,12,0,0" Visibility="Collapsed"
                  AutomationProperties.Name="Developer tools">
          <StackPanel Margin="0,10,0,0">
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Text="Synthetic demo" Style="{StaticResource SectionTitleStyle}"/>
                <TextBlock Text="Use synthetic or public content only. Model mode may process approved data remotely."
                           Style="{StaticResource CaptionStyle}" Margin="0,4,0,7"/>
                <WrapPanel>
                  <Button Content="Open demo" Click="OpenDemo_Click"/>
                </WrapPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Text="Build Center and Notepad" Style="{StaticResource SectionTitleStyle}"/>
                <TextBlock Text="Two bounded tasks: investigate the sample build or insert an approved draft into blank Notepad."
                           Style="{StaticResource CaptionStyle}" Margin="0,4,0,8"/>
                <WrapPanel>
                  <RadioButton x:Name="GuideMode" Content="Guide me" GroupName="Interaction"
                               IsChecked="True" Checked="Interaction_Changed"/>
                  <RadioButton x:Name="ControlMode" Content="Do it for me" GroupName="Interaction"
                               Checked="Interaction_Changed"/>
                </WrapPanel>
                <Button Content="Prepare demo task" Click="PrepareTask_Click" HorizontalAlignment="Left"/>
                <Expander Header="Notepad · approved draft" Margin="0,8,0,8">
                  <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="Experimental: select a separate Notepad window with one blank tab. No Save command is issued; Notepad may retain unsaved tabs."
                               Style="{StaticResource CaptionStyle}" Margin="0,0,0,7"/>
                    <TextBox x:Name="DraftBox"
                             Text="MSGuide demo: this draft was prepared with permission."
                             MaxLength="1000"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="64"
                             MaxHeight="140"
                             VerticalScrollBarVisibility="Auto"
                             IsUndoEnabled="False"
                             TextChanged="Draft_Changed"
                             AutomationProperties.Name="Exact approved Notepad draft"/>
                    <Button Content="Prepare selected Notepad task" Click="PrepareNotepad_Click"
                            HorizontalAlignment="Left" Margin="0,8,0,0"/>
                  </StackPanel>
                </Expander>
                <TextBlock x:Name="TaskPlanText"
                           Text="Open demo, choose a mode, and prepare the task."
                           Style="{StaticResource CaptionStyle}" Margin="0,4,0,4"/>
                <CheckBox x:Name="TaskConsent" Checked="TaskConsent_Changed" Unchecked="TaskConsent_Changed">
                  <TextBlock Text="I approve this exact plan, target, and local checks. In control mode, I also approve its listed actions. Only synthetic content is in scope."/>
                </CheckBox>
                <WrapPanel>
                  <Button x:Name="StartTaskButton" Content="Start approved task" Click="StartTask_Click"
                          Style="{StaticResource PrimaryButtonStyle}" IsEnabled="False"/>
                  <Button x:Name="ObserveTaskButton" Content="I did it · check" Click="ObserveTask_Click" IsEnabled="False"/>
                  <Button Content="Stop task" Click="StopTask_Click" Style="{StaticResource DangerButtonStyle}"/>
                  <Button Content="Take over manually" Click="TakeOver_Click" Style="{StaticResource QuietButtonStyle}"/>
                </WrapPanel>
                <TextBlock x:Name="TaskStatusText"
                           Text="No task active."
                           Foreground="{StaticResource AccentBrush}"
                           AutomationProperties.LiveSetting="Polite"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Expander>

        <Expander x:Name="ScreenContextExpander" Header="Screen context"
                  Margin="0,12,0,0" Visibility="Collapsed"
                  AutomationProperties.Name="Review screen context for guidance">
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Text="Review screen context" Style="{StaticResource SectionTitleStyle}"/>
                <TextBlock Text="Choose one window to capture locally. Review it before approving any sharing. Screen-based guidance does not authorize control actions."
                           Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                <TextBlock Text="Only public or synthetic content is supported for shared screen guidance. Do not share secrets or personal information."
                           Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock Text="Window" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <ComboBox x:Name="WindowPicker"
                          AutomationProperties.Name="Window to capture"
                          SelectionChanged="Window_Changed"/>
                <WrapPanel Margin="0,6,0,0">
                  <Button Content="Refresh windows" Click="Refresh_Click"/>
                  <Button x:Name="CaptureButton" Content="Capture and review" Click="Capture_Click"
                          Style="{StaticResource PrimaryButtonStyle}"/>
                  <Button Content="Close screen context" Click="CloseScreenContext_Click"
                          Style="{StaticResource QuietButtonStyle}"/>
                </WrapPanel>
                <Border Background="{StaticResource WarningSoftBrush}" CornerRadius="9" Padding="10" Margin="0,6,0,0">
                  <TextBlock Text="Screenshot pixels are not redacted. Review for passwords, secrets, and personal information before approval."
                             TextWrapping="Wrap"
                             FontSize="12" Foreground="{StaticResource WarningBrush}"/>
                </Border>
                <Border x:Name="ReviewPanel"
                        Visibility="Collapsed"
                        BorderBrush="{StaticResource BorderStrongBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12"
                        Margin="0,12,0,0">
                  <StackPanel>
                    <TextBlock Text="Review snapshot · expires in 60 seconds" FontWeight="SemiBold"/>
                    <TextBlock x:Name="CaptureDetails" Style="{StaticResource CaptionStyle}" Margin="0,5,0,8"/>
                    <Border Background="#05080D" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="8">
                      <Image x:Name="PreviewImage" MaxHeight="250" Stretch="Uniform"
                             AutomationProperties.Name="Actual selected-window capture preview"/>
                    </Border>
                    <Expander Header="Inspect image at full size" Margin="0,6,0,6">
                      <ScrollViewer Height="280" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Image x:Name="FullPreviewImage" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top"
                               AutomationProperties.Name="Full resolution captured image"/>
                      </ScrollViewer>
                    </Expander>
                    <TextBlock Text="UI Automation text and normalized element boxes sent on approval:"
                               Style="{StaticResource CaptionStyle}" Margin="0,5,0,4"/>
                    <TextBox x:Name="MetadataText"
                             IsReadOnly="True"
                             IsUndoEnabled="False"
                             TextWrapping="Wrap"
                             Height="130"
                             VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="Exact accessible text and element metadata to share"/>
                    <CheckBox x:Name="ShareImage" Checked="Approval_Changed" Unchecked="Approval_Changed">
                      <TextBlock Text="Also send screenshot pixels (off by default)."/>
                    </CheckBox>
                    <CheckBox x:Name="ConsentBox" Checked="Approval_Changed" Unchecked="Approval_Changed">
                      <TextBlock Text="I reviewed this snapshot and approve sending its text/boxes and, only if checked, image to the configured provider."/>
                    </CheckBox>
                    <WrapPanel>
                      <Button x:Name="SendButton" Content="Send approved snapshot" Click="Send_Click"
                              Style="{StaticResource PrimaryButtonStyle}" IsEnabled="False"/>
                      <Button Content="Discard" Click="Discard_Click"/>
                    </WrapPanel>
                  </StackPanel>
                </Border>
                <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="12" Margin="0,12,0,0">
                  <StackPanel>
                    <TextBlock x:Name="ModeText" Text="GUIDANCE · no response yet"
                               FontSize="11" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6"/>
                    <TextBlock x:Name="AnswerText"
                               Text="Choose a window, capture it locally, and review what you want to share."
                               TextWrapping="Wrap"
                               FontSize="15"
                               AutomationProperties.LiveSetting="Polite"/>
                    <StackPanel x:Name="CitationsPanel" Margin="0,8,0,0"/>
                    <WrapPanel>
                      <Button x:Name="NextButton" Content="Check next step" Click="Capture_Click"/>
                      <Button x:Name="SpeakButton" Content="Speak response" Click="Speak_Click" IsEnabled="False"/>
                    </WrapPanel>
                    <TextBlock Text="Check next step creates a new local full-window screenshot for review. It never uploads automatically."
                               Style="{StaticResource CaptionStyle}"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
        </Expander>
      </StackPanel>
    </ScrollViewer>

    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="HotkeyText"
                 Text="Ctrl+Alt+M · show near cursor"
                 Style="{StaticResource CaptionStyle}"
                 VerticalAlignment="Center"/>
      <Button Grid.Column="1"
              Content="Dismiss"
              Click="Dismiss_Click"
              Style="{StaticResource QuietButtonStyle}"
              AutomationProperties.Name="Dismiss MSGuide"/>
    </Grid>
  </Grid>
</Window>
